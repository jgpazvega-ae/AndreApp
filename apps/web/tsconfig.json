{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "noEmit": true,
    "composite": true,
    "types": ["vite/client"]
  },
  // Las pruebas quedan fuera del build de la app (usan APIs de Node y de
  // Vitest que no existen en el navegador); las revisa tsconfig.test.json.
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/__tests__", "e2e"]
}
